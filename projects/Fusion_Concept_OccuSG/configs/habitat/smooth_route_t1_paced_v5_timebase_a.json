        "navmesh/collision checks",
        "actual displacement and route endpoint checks"
      ],
      "wall_timeout_source": "camera runner --timeout-s"
    },
    "real_time_factor_target": 1.0,
    "requested_dt_semantics": "requested_step_dt_not_assumed_observed_delta",
    "requested_simulator_dt_s": 0.04,
    "schema": "habitat-motion-timebase/v2",
    "target_fps": 25.0,
    "timestamp_authority": "habitat_sim.Simulator.get_world_time_after_step",
